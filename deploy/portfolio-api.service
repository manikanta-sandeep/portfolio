# systemd unit for the portfolio API. setup-server.sh installs it to
# /etc/systemd/system/portfolio-api.service; the deploy workflow restarts it.
[Unit]
Description=Portfolio API (sandeeppuppala.com)
After=network.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/portfolio/server
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DATA_DIR=/var/lib/portfolio
Environment=SITE_URL=https://sandeeppuppala.com
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3

# The service can only write to its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/portfolio

[Install]
WantedBy=multi-user.target
